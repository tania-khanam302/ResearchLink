# Root .gitignore for the project

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Dependency directories
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
server/dist/
dist/
build/

# Vite cache
.vite/
node_modules/.vite/

# Environment files
.env
.env.*.local

# Coverage
coverage/
.nyc_output/

# Temp and uploads
temp/
temp/uploads/
uploads/
server/uploads/

# Editor directories and IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Caches
.cache/
.eslintcache

# Misc
*.pem
*.key
